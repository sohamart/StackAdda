{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://stackbackend-omega.vercel.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://stackbackend-omega.vercel.app/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|webp|png|jpg|jpeg|svg|gif|woff|woff2|ttf|eot|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
